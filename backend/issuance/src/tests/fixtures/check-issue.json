{
  "description": "Issue a credential for Check Alice",
  "method": "POST",
  "path": "/api/issue",
  "headers": { "Accept": "application/json" },
  "body": { "name": "Check Alice", "email": "check-alice@example.com" },
  "expectedStatus": 201,
  "expectedBody": {
    "message": "credential issued by {issuedBy}",
    "credentialId": "{credentialId}",
    "issuedBy": "{issuedBy}"
  },
  "normalize": { "wildcard": ["credentialId", "issuedBy"], "remove": ["issuedAt"] }
}
