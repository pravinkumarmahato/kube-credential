{
  "description": "Issue a credential via issuance service (over HTTP) - used by verification fixture",
  "method": "POST",
  "path": "/api/issue",
  "headers": { "Accept": "application/json" },
  "body": { "name": "Fixture Alice", "email": "fixture-alice@example.com" },
  "expectedStatus": 201,
  "expectedBody": {
    "message": "credential issued by {issuedBy}",
    "credentialId": "{credentialId}",
    "issuedBy": "{issuedBy}"
  },
  "normalize": { "wildcard": ["credentialId", "issuedBy"], "remove": ["issuedAt"] }
}
